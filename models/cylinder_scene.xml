<mujoco model="kikobot_cylinder_upright">
    <!-- Stand-up scene: same table, pad and camera as pick_place_scene.xml,
         but the object is a cylinder that spawns lying on its curved side. -->
    <include file="robot.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" offwidth="1280" offheight="720" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
        <material name="tabletop" rgba="0.72 0.58 0.43 1" reflectance="0.05" />
        <material name="table_frame" rgba="0.28 0.29 0.32 1" />
    </asset>

    <worldbody>
        <light pos="0.4 -0.4 2.2" dir="-0.2 0.2 -1" directional="true" diffuse="0.5 0.5 0.5" />
        <light pos="-0.5 0.5 1.8" dir="0.3 -0.3 -1" directional="false" diffuse="0.35 0.35 0.35" />

        <geom name="floor" size="0 0 0.05" pos="0 0 -0.4" type="plane" material="groundplane" />

        <geom name="tabletop" type="box" pos="0 0 -0.01" size="0.5 0.5 0.01"
            material="tabletop" />
        <geom name="table_leg_1" type="cylinder" fromto="0.45 0.45 -0.02 0.45 0.45 -0.4"
            size="0.022" material="table_frame" />
        <geom name="table_leg_2" type="cylinder" fromto="-0.45 0.45 -0.02 -0.45 0.45 -0.4"
            size="0.022" material="table_frame" />
        <geom name="table_leg_3" type="cylinder" fromto="0.45 -0.45 -0.02 0.45 -0.45 -0.4"
            size="0.022" material="table_frame" />
        <geom name="table_leg_4" type="cylinder" fromto="-0.45 -0.45 -0.02 -0.45 -0.45 -0.4"
            size="0.022" material="table_frame" />

        <!-- 30 mm diameter, 80 mm long. 30 mm leaves ~12 mm of jaw clearance
             per side, like the cube. condim 6 adds rolling friction, so a
             finger brushing the side does not send it rolling off. Torsional
             friction (2nd coefficient) is what stops it pivoting in the jaws
             when held off-centre. -->
        <body name="target_cylinder" pos="0.25 0.0 0.015" euler="90 0 0">
            <freejoint name="target_cylinder_free" />
            <geom name="target_cylinder" type="cylinder" size="0.015 0.04"
                rgba="0.95 0.55 0.1 1" mass="0.03" friction="1.5 0.02 0.002"
                solref="0.004 1" condim="6" />
        </body>

        <body name="place_pad" mocap="true" pos="0.26 0.22 0.008">
            <geom name="place_pad" type="cylinder" size="0.055 0.008"
                rgba="0.13 0.72 0.25 1" friction="1.5 0.02 0.002" condim="4" />
        </body>

        <camera name="record" pos="0.78 0.0 0.34" mode="targetbody" target="base_plate"
            fovy="48" resolution="1280 720" />
    </worldbody>
</mujoco>
